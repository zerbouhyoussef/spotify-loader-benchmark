{
  "title": "Spotify Loader Benchmark",
  "uid": "spotify-benchmark",
  "version": 2,
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "tags": ["benchmark", "performance"],
  "panels": [
    {
      "id": 1,
      "title": "🏁 Loader Race — Playlists Inserted Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 12 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "legend": { 
          "displayMode": "table", 
          "placement": "right",
          "showLegend": true,
          "calcs": ["last", "max", "mean"]
        },
        "tooltip": { 
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { 
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 4,
            "fillOpacity": 25,
            "gradientMode": "hue",
            "spanNulls": true,
            "pointSize": 10,
            "showPoints": "never",
            "axisPlacement": "auto",
            "axisLabel": "Playlists Loaded",
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT run_at AS time, loader_name AS metric, playlists AS value FROM benchmark_results WHERE $__timeFilter(run_at) ORDER BY run_at",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "⚡ Throughput (Playlists/sec)",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" },
        "xField": "loader_name",
        "barWidth": 0.85,
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT loader_name, ROUND((playlists / NULLIF(duration_s, 0))::numeric, 1) AS throughput FROM benchmark_results WHERE run_id = (SELECT run_id FROM benchmark_results ORDER BY run_at DESC LIMIT 1) ORDER BY throughput DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "📊 Total Duration (seconds)",
      "type": "barchart",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" },
        "xField": "loader_name",
        "barWidth": 0.85,
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "continuous-BlPu" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT loader_name, duration_s FROM benchmark_results WHERE run_id = (SELECT run_id FROM benchmark_results ORDER BY run_at DESC LIMIT 1) ORDER BY duration_s ASC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "🎯 Tracks Loaded per Second",
      "type": "barchart",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "hidden" },
        "tooltip": { "mode": "single" },
        "xField": "loader_name",
        "barWidth": 0.85,
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "green", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT loader_name, ROUND((tracks / NULLIF(duration_s, 0))::numeric, 0) AS tracks_per_sec FROM benchmark_results WHERE run_id = (SELECT run_id FROM benchmark_results ORDER BY run_at DESC LIMIT 1) ORDER BY tracks_per_sec DESC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "📈 Performance Trends Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 9 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "legend": { 
          "displayMode": "table", 
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "last", "min", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { 
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 3,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": true,
            "pointSize": 8,
            "showPoints": "auto",
            "axisPlacement": "auto",
            "axisLabel": "Duration (seconds)"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT run_at AS time, loader_name AS metric, duration_s AS value FROM benchmark_results WHERE $__timeFilter(run_at) ORDER BY run_at",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "🏆 Winner Ranking (Lower is Better)",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 9 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "orange", "value": 40 },
              { "color": "red", "value": 60 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT loader_name, duration_s FROM benchmark_results WHERE run_id = (SELECT run_id FROM benchmark_results ORDER BY run_at DESC LIMIT 1) ORDER BY duration_s ASC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "📋 Complete Benchmark History",
      "type": "table",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
      "options": {
        "sortBy": [{ "displayName": "run_at", "desc": true }],
        "footer": { "show": false },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "duration_s" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.displayMode", "value": "gradient-gauge" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "errors" },
            "properties": [
              {
                "id": "thresholds",
                "value": { 
                  "mode": "absolute", 
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "playlists" },
            "properties": [{ "id": "custom.displayMode", "value": "lcd-gauge" }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "benchmark-postgres" },
          "rawSql": "SELECT run_at, run_id, loader_name, duration_s, playlists, tracks, errors, ROUND((playlists/NULLIF(duration_s,0))::numeric, 1) as throughput FROM benchmark_results ORDER BY run_at DESC LIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
